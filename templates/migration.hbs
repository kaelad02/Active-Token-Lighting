<section class="standard-form scrollable">
  <p>{{{localize "ATL.Migration.app.description"}}}</p>
  <div class="warning"><i class="fas fa-triangle-exclamation"></i> {{localize "ATL.Migration.app.warning"}}</div>

  <div class="form-group">
    <label>{{localize "ATL.Migration.app.packLabel"}}</label>
    <div class="form-fields">
      <select name="pack" data-dtype="String">
        {{selectOptions packs valueAttr="id" labelAttr="label" groups=packages blank=""}}
      </select>
    </div>
  </div>
</section>
